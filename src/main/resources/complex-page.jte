@import org.ujorm.benchmark.HtmlBenchmark.Fortune
@param java.util.List<Fortune> fortunes
@param java.util.List<String> menuItems
@param boolean showPromo

<html>
<body>
    <header>
        <h1>Fortune Board</h1>
    </header>
    <nav>
        <ul>
            @for(String item : menuItems)
            <li>${item}</li>
            @endfor
        </ul>
    </nav>
    @if(showPromo)
    <p>Promo mode is enabled.</p>
    @endif
    <section>
        <table>
            @for(Fortune fortune : fortunes)
            <tr>
                <td>${fortune.id()}</td>
                <td>${fortune.message()}</td>
                <td>${fortune.author()}</td>
                <td>
                    <ul>
                        @for(String token : org.ujorm.benchmark.HtmlBenchmark.tokensOf(fortune.message()))
                        <li>${token}</li>
                        @endfor
                    </ul>
                </td>
            </tr>
            @endfor
        </table>
    </section>
    <footer>
        <p>Generated by JTE benchmark.</p>
    </footer>
</body>
</html>
